# Loaded by `vite build`. The admin dashboard reads the live CodeSight
# backend's read-only admin views. The API is public and unauthenticated;
# create/update/delete/approve are not available (exercises live in the repo).
VITE_API_BASE_URL=https://codesight-code-review-production.up.railway.app
VITE_USE_MOCK_API=false
