# Copy to .env and fill in. .env is gitignored — never commit the real key.

# Google AI Studio API key (https://aistudio.google.com/apikey).
# GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=

# Comma-separated origins allowed to call this API (browser CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Postgres connection string (Neon or Railway).
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave blank for local dev to fall back to a local SQLite file.
DATABASE_URL=

# Grading model. Default is gemini-3.6-flash. Set a -pro variant for higher
# quality if your key has access.
GRADER_MODEL=gemini-3.6-flash
