# Copy to .env and fill in. .env is gitignored — never commit the real key.

# Google AI Studio API key (https://aistudio.google.com/apikey).
# GOOGLE_API_KEY is also accepted.
GEMINI_API_KEY=

# Extra keys, ONLY used by scripts/generate_exercises.py to rotate past the
# free-tier per-day limit (500 req/day/project on gemini-3.5-flash-lite).
# Each must be from a different Google project. Not used by the live API.
# GEMINI_API_KEY2=
# GEMINI_API_KEY3=

# Comma-separated exact origins allowed to call this API (browser CORS).
# Only needed for a custom domain — any *.vercel.app already matches the regex.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Regex fallback (has a built-in default; override or set "" to disable).
# ALLOWED_ORIGIN_REGEX=https://[a-z0-9-]+\.vercel\.app|http://localhost:\d+

# Postgres connection string (Neon or Railway).
#   postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Leave blank for local dev to fall back to a local SQLite file.
DATABASE_URL=

# Grading model. Default is gemini-3.6-flash. Set a -pro variant for higher
# quality if your key has access.
GRADER_MODEL=gemini-3.6-flash

# Admin API. Unset -> every /admin/* route returns 503. Set it and the admin
# dashboard can log in (POST /admin/login) and edit exercises (a Postgres
# overlay on the committed JSON). Use a long random string.
ADMIN_PASSWORD=
# ADMIN_TOKEN_TTL_HOURS=12
