rules_version = '2';

// CodeSight — Firestore security rules.
//
// One document per user at users/{uid}. A signed-in user may:
//   - read only their own doc
//   - create their own doc on sign-up, with identity + track/level/streak fields
//   - update profile fields (displayName, photoURL, track, level, streak)
//
// Score fields (totalXP, eloRating, problemsSolved, weaknessCatchRates, recentSubmissions)
// are owned by the backend and written ONLY via the Admin SDK, which bypasses these
// rules. The client can never write stats directly. Stats are populated on user signup
// via backend service, with client writes limited to identity + learning progress fields.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {

      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // fields the client is allowed to set when first creating its doc
      function createFields() {
        return [
          'uid', 'email', 'displayName', 'photoURL', 'provider', 'createdAt',
          'track', 'level', 'levelIndex', 'streakDays', 'lastActiveDate'
        ];
      }

      // fields the client may change after creation
      function editableFields() {
        return [
          'displayName', 'photoURL', 'track', 'level', 'levelIndex',
          'streakDays', 'lastActiveDate', 'updatedAt'
        ];
      }

      allow read: if isOwner();

      allow create: if isOwner()
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(createFields());

      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableFields());

      allow delete: if false;
    }

    // everything else is closed to clients
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
