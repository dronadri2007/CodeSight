# CodeSight frontend environment

# FastAPI backend base URL. Unset  -> the app runs on local mock data / stubs.
# Set it to go live against the deployed backend:
VITE_API_BASE_URL=https://codesight-code-review-production.up.railway.app

# For local backend dev instead:
# VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Firebase (Authentication + Firestore user profiles)
# From Firebase console -> Project settings -> Your apps -> Web app -> Config.
# These are NOT secret; they ship in the client bundle by design.
# Without them, /auth shows a "not configured" notice and the app stays locked.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
